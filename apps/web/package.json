{
	"name": "tellegen-frontend",
	"version": "0.1.1",
	"private": true,
	"description": "SvelteKit hosted demo for tellegen power system maps.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"engine:build": "npm --prefix ../.. run build:engine",
		"smoke:build": "node scripts/smoke-build.mjs",
		"test:browser": "playwright test",
		"wasm": "npm --prefix ../.. run wasm",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"dependencies": {
		"@tellegen/svelte": "^0.2.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.1"
	}
}
