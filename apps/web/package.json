{
	"name": "tellegen-frontend",
	"version": "0.1.1",
	"private": true,
	"description": "SvelteKit hosted demo for tellegen power system maps.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"engine:build": "npm --prefix ../.. run build:engine",
		"smoke:build": "node scripts/smoke-build.mjs",
		"test:browser": "playwright test",
		"wasm": "npm --prefix ../.. run wasm",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run test:study-goals",
		"test:study-goals": "node --experimental-strip-types scripts/test-goal-form.mjs",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"dependencies": {
		"@deck.gl/core": "^9.4.0",
		"@deck.gl/layers": "^9.4.0",
		"@deck.gl/maplibre": "^9.4.0",
		"@tellegen/svelte": "^0.4.3",
		"@tellegen/webmcp": "^0.1.0",
		"maplibre-gl": "^6.15.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
