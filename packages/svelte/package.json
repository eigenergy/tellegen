{
  "name": "@tellegen/svelte",
  "version": "0.5.1",
  "description": "Svelte components for tellegen power system maps, local case files, and browser solves.",
  "keywords": [
    "svelte",
    "sveltekit",
    "power-flow",
    "optimal-power-flow",
    "power-systems",
    "map",
    "maplibre",
    "deck.gl",
    "webassembly",
    "visualization",
    "grid"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eigenergy/tellegen.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/eigenergy/tellegen/issues"
  },
  "homepage": "https://eigenergy.github.io/tellegen/",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "svelte": "./dist/components.js",
      "default": "./dist/components.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "svelte": "./dist/map.js",
      "default": "./dist/map.js"
    },
    "./maplibre-worker": {
      "types": "./dist/maplibre-worker.d.ts",
      "development": "./dist/maplibre-worker.dev.js",
      "default": "./dist/maplibre-worker.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "pack:dry-run": "npm pack --dry-run --cache ../../node_modules/.cache/npm-pack"
  },
  "dependencies": {
    "@tellegen/engine": "^0.5.1"
  },
  "peerDependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/maplibre": "^9.4.0",
    "maplibre-gl": "^6.15.0",
    "svelte": ">=5.30 <6"
  },
  "devDependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/maplibre": "^9.4.1",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "maplibre-gl": "^6.16.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.1.0"
  }
}
