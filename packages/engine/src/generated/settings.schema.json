  "schema": {
    "$defs": {
      "Calculation": {
        "description": "A calculation the common settings API resolves and runs. Each variant's\nJSON name is the wire value every interface accepts.",
        "enum": [
          "mc_ac_pf",
          "dcopf",
          "acpf",
          "dcpf",
          "socwr",
          "acopf"
        ],
        "type": "string"
      },
      "CalculationRequest": {
        "additionalProperties": false,
        "description": "A stateless calculation over one input module. Build one with\n[`CalculationRequest::new`] and the `with_*` methods.",
        "properties": {
          "edits": {
            "$ref": "#/$defs/Edits",
            "default": {
              "deltas": {},
              "rates": {}
            }
          },
          "energized_only": {
            "default": false,
            "description": "Source-less islands are excluded only by this explicit selection.",
            "type": "boolean"
          },
          "module_json": {
            "type": "string"
          },
          "settings": {
            "$ref": "#/$defs/SettingsRequest"
          }
        },
        "required": [
          "module_json",
          "settings"
        ],
        "type": "object"
      },
      "CalculationResult": {
        "properties": {
          "result": true,
          "settings": {
            "$ref": "#/$defs/ResolvedSettings"
          }
        },
        "required": [
          "settings",
          "result"
        ],
        "type": "object"
      },
      "Edits": {
        "description": "Operating-point edits applied before the model is built: demand deltas in MW\nkeyed by bus (the operating point is `base demand + delta`) and branch rating\ndeltas in MW keyed by branch (the thermal limit is `base rating + delta`). Keys\nare [`ElementKey`]s — the original numeric id or the powerio row uid. A struct\n(not a bare map) so the structural-edit vocabulary (add line, add generator,\nretune a parameter) can grow without breaking the wire format: a client that\nknows only `deltas` keeps working.",
        "properties": {
          "deltas": {
            "additionalProperties": {
              "format": "double",
              "type": "number"
            },
            "default": {},
            "description": "Active-power demand delta in MW per bus key.",
            "type": "object"
          },
          "rates": {
            "additionalProperties": {
              "format": "double",
              "type": "number"
            },
            "default": {},
            "description": "Thermal rating delta in MW per branch key. Supported by the DC OPF\nand SOCWR paths; the AC power flow has no flow limits and rejects them.",
            "type": "object"
          }
        },
        "type": "object"
      },
      "ResolvedSettings": {
        "properties": {
          "baseline": {
            "additionalProperties": true,
            "type": "object"
          },
          "calculation": {
            "$ref": "#/$defs/Calculation"
          },
          "effective": {
            "additionalProperties": true,
            "type": "object"
          },
          "engine_defaults": {
            "additionalProperties": true,
            "type": "object"
          },
          "overrides": {
            "additionalProperties": true,
            "type": "object"
          },
          "version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "version",
          "calculation",
          "engine_defaults",
          "baseline",
          "overrides",
          "effective"
        ],
        "type": "object"
      },
      "SettingsRequest": {
        "additionalProperties": false,
        "description": "Which calculation to configure, and the option layers over its defaults.\nBuild one with [`SettingsRequest::new`] and the `with_*` methods.",
        "properties": {
          "baseline": {
            "additionalProperties": true,
            "default": {},
            "description": "Case or study defaults, applied over the engine defaults.",
            "type": "object"
          },
          "calculation": {
            "$ref": "#/$defs/Calculation"
          },
          "overrides": {
            "additionalProperties": true,
            "default": {},
            "description": "The caller's explicit choices, applied last.",
            "type": "object"
          }
        },
        "required": [
          "calculation"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "calculation": {
        "$ref": "#/$defs/CalculationRequest"
      },
      "resolved": {
        "$ref": "#/$defs/ResolvedSettings"
      },
      "result": {
        "$ref": "#/$defs/CalculationResult"
      },
      "settings": {
        "$ref": "#/$defs/SettingsRequest"
      }
    },
    "required": [
      "settings",
      "resolved",
      "calculation",
      "result"
    ],
    "title": "Contract",
    "type": "object"
  },
