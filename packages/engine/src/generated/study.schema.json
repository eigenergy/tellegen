{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "powerio_ir",
        "evidence"
      ],
      "type": "string"
    },
    "Bound": {
      "description": "A min or max bound, e.g. the lower/upper voltage-magnitude limit.",
      "enum": [
        "Min",
        "Max"
      ],
      "type": "string"
    },
    "BranchFlow": {
      "description": "Branch flows, keyed by original branch id (plus the row uid when carried, as in\n[`BusScalar`]). `pf` (from-end active, MW) and `loading` (|S|/limit,\ndimensionless) are present on every formulation that has flows; the reactive\nand to-end legs are `None` on the DC paths.",
      "properties": {
        "branch": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "loading": {
          "format": "double",
          "type": "number"
        },
        "pf": {
          "format": "double",
          "type": "number"
        },
        "pt": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "qf": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "qt": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "uid": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "branch",
        "pf",
        "loading"
      ],
      "type": "object"
    },
    "BranchScalar": {
      "description": "A branch-indexed voltage product, in squared per unit.",
      "properties": {
        "branch": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "branch",
        "value"
      ],
      "type": "object"
    },
    "BusInjection": {
      "description": "A nodal net injection (MW / MVAr), keyed by original bus id (plus the row uid\nwhen carried, as in [`BusScalar`]). Injections describe the net nodal power balance.",
      "properties": {
        "bus": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "p": {
          "format": "double",
          "type": "number"
        },
        "q": {
          "format": "double",
          "type": "number"
        },
        "uid": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "bus",
        "p",
        "q"
      ],
      "type": "object"
    },
    "BusScalar": {
      "description": "A scalar keyed by original bus id (LMP, voltage, angle, squared magnitude).\n`uid` is the bus's powerio row uid when the solved network carried one, so an\noverlay can re-key on stable identity instead of the positional id.",
      "properties": {
        "bus": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "uid": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "bus",
        "value"
      ],
      "type": "object"
    },
    "ColMeta": {
      "description": "Identity and quantity metadata for one column of a [`SensitivityMatrix`].",
      "properties": {
        "element": {
          "$ref": "#/$defs/ElementId"
        },
        "index": {
          "description": "Dense index of the element this column varies.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "parameter": {
          "$ref": "#/$defs/Parameter"
        }
      },
      "required": [
        "parameter",
        "element",
        "index"
      ],
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "type": "string"
        },
        "improvement": {
          "format": "double",
          "type": "number"
        },
        "left": {
          "type": "string"
        },
        "left_value": {
          "format": "double",
          "type": "number"
        },
        "left_view": {
          "$ref": "#/$defs/SolveResponse"
        },
        "right": {
          "type": "string"
        },
        "right_value": {
          "format": "double",
          "type": "number"
        },
        "right_view": {
          "$ref": "#/$defs/SolveResponse"
        }
      },
      "required": [
        "goal",
        "left",
        "right",
        "left_value",
        "right_value",
        "improvement",
        "left_view",
        "right_view"
      ],
      "type": "object"
    },
    "CostTerm": {
      "description": "Which generation-cost coefficient: the quadratic `cq` or the linear `cl`.",
      "enum": [
        "Quadratic",
        "Linear"
      ],
      "type": "string"
    },
    "CreateStudy": {
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "$ref": "#/$defs/DecisionSpace"
        },
        "formulation": {
          "enum": [
            "dcopf",
            "acpf",
            "socwr"
          ],
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "interpretation": {
          "type": "string"
        },
        "objective": {
          "$ref": "#/$defs/StudyObjective"
        },
        "request": {
          "type": "string"
        },
        "success_value": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "input",
        "formulation",
        "request",
        "interpretation",
        "objective",
        "decisions"
      ],
      "type": "object"
    },
    "DecisionKind": {
      "enum": [
        "retain",
        "reject",
        "recommend",
        "apply"
      ],
      "type": "string"
    },
    "DecisionRecord": {
      "additionalProperties": false,
      "properties": {
        "choice": {
          "$ref": "#/$defs/DecisionKind"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "experiment": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "experiment",
        "choice",
        "rationale",
        "evidence"
      ],
      "type": "object"
    },
    "DecisionSpace": {
      "additionalProperties": false,
      "description": "The feasible set, distinct from both the inner problem and the outer goal.",
      "properties": {
        "demand": {
          "anyOf": [
            {
              "$ref": "#/$defs/DemandConstraint"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_changed_elements": {
          "format": "uint",
          "maximum": 4096,
          "minimum": 1,
          "type": "integer"
        },
        "total_budget": {
          "format": "double",
          "minimum": 0,
          "type": "number"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/DecisionVariable"
          },
          "maxItems": 4096,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "variables",
        "total_budget",
        "max_changed_elements"
      ],
      "type": "object"
    },
    "DecisionVariable": {
      "additionalProperties": false,
      "description": "Bounds and increments apply to changes from the goal's anchor state in a Study.",
      "properties": {
        "budget_weight": {
          "description": "Budget consumption per absolute unit of intervention.",
          "format": "double",
          "type": "number"
        },
        "element": {
          "$ref": "#/$defs/ElementKey"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "increment": {
          "format": "double",
          "type": "number"
        },
        "intervention": {
          "$ref": "#/$defs/Intervention"
        },
        "lower": {
          "format": "double",
          "type": "number"
        },
        "upper": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "element",
        "intervention",
        "lower",
        "upper",
        "increment",
        "budget_weight"
      ],
      "type": "object"
    },
    "DemandConstraint": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Allocate this additional MW across the declared demand decisions.",
          "properties": {
            "increase_mw": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "placement",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "increase_mw"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Preserve the existing total MW across the declared demand decisions.",
          "properties": {
            "kind": {
              "const": "redistribution",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ElementId": {
      "description": "A source-id reference for a dense row or column, so a [`SensitivityMatrix`]\nself-describes and the api serializes it without re-deriving id maps.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "Bus": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "Bus"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Branch": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "Branch"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "Generator": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "Generator"
          ],
          "type": "object"
        }
      ]
    },
    "ElementKey": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "End": {
      "description": "Which end of a branch a flow is measured at.",
      "enum": [
        "From",
        "To"
      ],
      "type": "string"
    },
    "ExperimentKind": {
      "enum": [
        "inspection",
        "sensitivity",
        "planning",
        "counterfactual",
        "challenge",
        "historical_import"
      ],
      "type": "string"
    },
    "ExperimentRecord": {
      "additionalProperties": false,
      "description": "Stated rationales and evidence references describe observable agent actions.",
      "properties": {
        "assessed_recommendation": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "goal": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ExperimentKind"
        },
        "rationale": {
          "type": "string"
        },
        "result_states": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "solve_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "start_state": {
          "description": "Historical imports can lack recoverable electrical state and goal data.",
          "type": [
            "string",
            "null"
          ]
        },
        "termination": {
          "type": "string"
        },
        "trials": {
          "items": {
            "$ref": "#/$defs/TrialRecord"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "rationale",
        "evidence",
        "trials",
        "result_states",
        "solve_count",
        "termination"
      ],
      "type": "object"
    },
    "ExperimentSummary": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ExperimentKind"
        },
        "rationale": {
          "type": "string"
        },
        "result_states": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "solve_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "start_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "termination": {
          "type": "string"
        },
        "trial_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "rationale",
        "solve_count",
        "trial_count",
        "result_states",
        "termination"
      ],
      "type": "object"
    },
    "GB": {
      "description": "Conductance `g` or susceptance `b`, the real/imaginary parts of an admittance.",
      "enum": [
        "Conductance",
        "Susceptance"
      ],
      "type": "string"
    },
    "GenDispatch": {
      "description": "Generator dispatch, keyed by original generator id. `qg` is `None` on the DC paths.",
      "properties": {
        "bus": {
          "description": "Original bus identity, allowing exact aggregation of co-located dispatch.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "gen": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pg": {
          "format": "double",
          "type": "number"
        },
        "qg": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "gen",
        "pg"
      ],
      "type": "object"
    },
    "GoalRevision": {
      "additionalProperties": false,
      "description": "A goal revision retains its own anchor and interpretation.",
      "properties": {
        "anchor_state": {
          "type": "string"
        },
        "decisions": {
          "$ref": "#/$defs/DecisionSpace"
        },
        "interpretation": {
          "type": "string"
        },
        "objective": {
          "$ref": "#/$defs/StudyObjective"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "request": {
          "type": "string"
        },
        "success_value": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "anchor_state",
        "request",
        "interpretation",
        "objective",
        "decisions"
      ],
      "type": "object"
    },
    "Intervention": {
      "description": "A numerical intervention supported by the existing solvers.",
      "enum": [
        "branch_rating",
        "active_demand"
      ],
      "type": "string"
    },
    "Iterations": {
      "anyOf": [
        {
          "description": "Interior-point iterate trace (dcopf / socwr).",
          "items": {
            "$ref": "#/$defs/SolveIteration"
          },
          "type": "array"
        },
        {
          "description": "Newton iteration count and final infinity-norm mismatch (acpf).",
          "properties": {
            "count": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "residual": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "count",
            "residual"
          ],
          "type": "object"
        }
      ],
      "description": "The convergence record. OPF paths carry the full interior-point trace (for the\nsolve-card sparkline); the AC power flow carries its Newton count and final\nmismatch. Untagged: the OPF arm serializes to the same bare array the DC OPF\nalways returned."
    },
    "ObservableWeight": {
      "additionalProperties": false,
      "description": "A weighted observable in the units reported by the selected formulation.",
      "properties": {
        "element": {
          "$ref": "#/$defs/ElementKey"
        },
        "weight": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "element",
        "weight"
      ],
      "type": "object"
    },
    "Operand": {
      "description": "What a sensitivity is taken *of*, named for the physical power quantity rather\nthan a formulation's internal variable. The orthogonal sub-axes (active/reactive,\nfrom/to, voltage representation) are visible to the type system; each formulation\nmaps a request to its own KKT rows or returns [`SensError::Unsupported`].\n\nThe dialects fold into one vocabulary: DC `Angle` is `Voltage(Angle)`, the conic\nsquared magnitude `w` is `Voltage(Squared)`, the nodal price is `Price(Active)`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Nodal-balance dual (the LMP for active power, the reactive price for\nreactive), per bus.",
          "properties": {
            "Price": {
              "$ref": "#/$defs/Power"
            }
          },
          "required": [
            "Price"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Generator dispatch `pg` / `qg`, per generator.",
          "properties": {
            "Dispatch": {
              "$ref": "#/$defs/Power"
            }
          },
          "required": [
            "Dispatch"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Branch active/reactive flow at the from/to end, per branch.",
          "properties": {
            "Flow": {
              "properties": {
                "end": {
                  "$ref": "#/$defs/End"
                },
                "power": {
                  "$ref": "#/$defs/Power"
                }
              },
              "required": [
                "power",
                "end"
              ],
              "type": "object"
            }
          },
          "required": [
            "Flow"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Bus voltage in the formulation's representation (`vm` / `va` / `w` / `wr` /\n`wi`), per bus.",
          "properties": {
            "Voltage": {
              "$ref": "#/$defs/VoltageKind"
            }
          },
          "required": [
            "Voltage"
          ],
          "type": "object"
        }
      ]
    },
    "Parameter": {
      "description": "What a sensitivity is taken *with respect to* — the parameter whose hand-derived\n`dK/dp` column drives the solve.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Bus active/reactive demand `pd` / `qd`, per bus.",
          "properties": {
            "Demand": {
              "$ref": "#/$defs/Power"
            }
          },
          "required": [
            "Demand"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Generation cost coefficient, per generator.",
          "properties": {
            "Cost": {
              "$ref": "#/$defs/CostTerm"
            }
          },
          "required": [
            "Cost"
          ],
          "type": "object"
        },
        {
          "const": "LineLimit",
          "description": "DC thermal limit `fmax` / AC-conic apparent-power `|S|` limit, per branch.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Branch series admittance `g` / `b`, per branch.",
          "properties": {
            "SeriesAdmittance": {
              "$ref": "#/$defs/GB"
            }
          },
          "required": [
            "SeriesAdmittance"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Bus shunt admittance `gs` / `bs`, per bus.",
          "properties": {
            "ShuntAdmittance": {
              "$ref": "#/$defs/GB"
            }
          },
          "required": [
            "ShuntAdmittance"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Voltage-magnitude bound right-hand side (the `w = |V|²` bound), per bus.",
          "properties": {
            "VoltageBound": {
              "$ref": "#/$defs/Bound"
            }
          },
          "required": [
            "VoltageBound"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Generator output bound right-hand side (`pmax` / `pmin` / `qmax` / `qmin`),\nper generator.",
          "properties": {
            "GenBound": {
              "properties": {
                "bound": {
                  "$ref": "#/$defs/Bound"
                },
                "power": {
                  "$ref": "#/$defs/Power"
                }
              },
              "required": [
                "power",
                "bound"
              ],
              "type": "object"
            }
          },
          "required": [
            "GenBound"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Transformer tap ratio / phase shift, per branch.",
          "properties": {
            "Transformer": {
              "$ref": "#/$defs/TapKind"
            }
          },
          "required": [
            "Transformer"
          ],
          "type": "object"
        },
        {
          "const": "Switching",
          "description": "Branch switching state `sw` in `[0, 1]`, per branch.",
          "type": "string"
        }
      ]
    },
    "Power": {
      "description": "Active or reactive power. The orthogonal P/Q sub-axis shared by prices,\ndispatch, flows, and demand.",
      "enum": [
        "Active",
        "Reactive"
      ],
      "type": "string"
    },
    "Problem": {
      "description": "Which problem to solve. The convex/power flow solve paths, as the lowercase JSON\ntags `\"dcpf\"`/`\"dcopf\"`/`\"acpf\"`/`\"socwr\"`. A plain (not internally tagged) enum\nso a request that omits it defaults to [`DcOpf`](Problem::DcOpf), and `{}` is a\nvalid base-case DC OPF request.\n\nThe `\"acopf\"` tag (full nonlinear AC OPF) is retained for wire-format stability\nbut is not solved by this build: [`capabilities_json`] reports it unavailable and\nrequesting it returns a clean `Err`.",
      "oneOf": [
        {
          "const": "dcpf",
          "description": "DC power flow: angles and flows at the fixed generator setpoints. No prices,\nno dispatch, no sensitivity.",
          "type": "string"
        },
        {
          "const": "dcopf",
          "description": "DC OPF: the LMP / dispatch / flow workhorse. Differentiable via the DC KKT.",
          "type": "string"
        },
        {
          "const": "acpf",
          "description": "AC polar Newton power flow. Voltages and nodal injections. Differentiable\nvia the AC Newton system.",
          "type": "string"
        },
        {
          "const": "socwr",
          "description": "SOCWR (Jabr) conic relaxation of AC OPF. Differentiable via the conic KKT.",
          "type": "string"
        },
        {
          "const": "acopf",
          "description": "Full nonlinear AC OPF. Not available in this build (the dispatch errors\ncleanly); the tag is kept so the JSON contract stays stable.",
          "type": "string"
        }
      ]
    },
    "RowMeta": {
      "description": "Identity and quantity metadata for one row of a [`SensitivityMatrix`].",
      "properties": {
        "element": {
          "$ref": "#/$defs/ElementId"
        },
        "index": {
          "description": "Dense index of the element this row reports.",
