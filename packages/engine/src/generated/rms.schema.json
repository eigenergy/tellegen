{
  "$defs": {
    "AngleScreen": {
      "description": "Rotor angle figures, degrees.",
      "properties": {
        "first_swing_deg": {
          "description": "The largest first swing: per machine the largest distance of\n`δ − δ_COI` from its value before the first event, up to its first\nextremum after the last event. Compare `max_coi_angle_deg`, not\nthis, with the pole-slip criterion.",
          "format": "double",
          "type": "number"
        },
        "first_swing_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "initial_separation_deg": {
          "default": 0.0,
          "description": "The separation before the first event (at the start without\nevents): the steady-state spread the event starts from.",
          "format": "double",
          "type": "number"
        },
        "max_coi_angle_deg": {
          "description": "The largest `|δ − δ_COI|` over the run, which unit and when.",
          "format": "double",
          "type": "number"
        },
        "max_coi_angle_t": {
          "format": "double",
          "type": "number"
        },
        "max_coi_angle_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_separation_deg": {
          "description": "The largest `max δ − min δ` among the machines in service of one\nisland from the first event on (over the whole run without events),\nthe pair and when.",
          "format": "double",
          "type": "number"
        },
        "pair": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pole_slips": {
          "items": {
            "$ref": "#/$defs/PoleSlip"
          },
          "type": "array"
        },
        "separation_t": {
          "format": "double",
          "type": "number"
        },
        "settled": {
          "type": "boolean"
        },
        "trend": {
          "anyOf": [
            {
              "$ref": "#/$defs/SwingTrend"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "max_separation_deg",
        "pair",
        "separation_t",
        "max_coi_angle_deg",
        "max_coi_angle_t",
        "first_swing_deg",
        "pole_slips",
        "settled"
      ],
      "type": "object"
    },
    "FrequencyScreen": {
      "description": "Frequency figures, Hz (the COI of the island with the most inertia).",
      "properties": {
        "coi_nadir_hz": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "coi_peak_hz": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "final_hz": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "lowest_bus": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "lowest_bus_hz": {
          "description": "The lowest estimated bus frequency and where.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "lowest_bus_t": {
          "format": "double",
          "type": "number"
        },
        "lowest_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "lowest_unit_hz": {
          "description": "The lowest unit speed (in service), Hz, and which unit.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "lowest_unit_t": {
          "format": "double",
          "type": "number"
        },
        "max_rocof_hz_s": {
          "description": "Largest `|Δf_COI| / window` over the sliding window, Hz/s.",
          "format": "double",
          "type": "number"
        },
        "nadir_t": {
          "format": "double",
          "type": "number"
        },
        "nominal_hz": {
          "format": "double",
          "type": "number"
        },
        "peak_t": {
          "format": "double",
          "type": "number"
        },
        "rocof_t": {
          "format": "double",
          "type": "number"
        },
        "settled": {
          "type": "boolean"
        }
      },
      "required": [
        "nominal_hz",
        "nadir_t",
        "peak_t",
        "max_rocof_hz_s",
        "rocof_t",
        "settled",
        "lowest_bus_t",
        "lowest_unit_t"
      ],
      "type": "object"
    },
    "InputSignal": {
      "description": "A controller reference a [`RmsEvent::SetReference`] sets (and a frequency\nresponse perturbs).",
      "oneOf": [
        {
          "const": "v_ref",
          "description": "Exciter voltage reference (field voltage for a fixed exciter).",
          "type": "string"
        },
        {
          "const": "p_ref",
          "description": "Governor power reference (mechanical torque for a fixed governor).",
          "type": "string"
        }
      ]
    },
    "IslandScreen": {
      "description": "One island with a unit in service at the end of the run.",
      "properties": {
        "buses": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "final_hz": {
          "description": "Its COI frequency at the end (`None` without a synchronous machine).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "inertia_mws": {
          "description": "`Σ H · MBASE` of its machines in service, MW·s.",
          "format": "double",
          "type": "number"
        },
        "machines": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "runaway": {
          "type": "boolean"
        }
      },
      "required": [
        "buses",
        "machines",
        "inertia_mws",
        "runaway"
      ],
      "type": "object"
    },
    "LoadModel": {
      "description": "How static loads respond to voltage during the simulation.\n\nThe default keeps every load's own law: the constant-power part, the ZIP\nconstant-current and constant-impedance parts and exponential loads, the\nsame decomposition the AC power flow solves (each part `P0 (V / V0)^γ`\nwith `P0` its power at the power flow voltage `V0`), so the loads draw\nexactly the power flow demand at `t = 0`. The other variants are a global\noverride: the whole bus demand at `V0`, whatever its parts, follows one\nlaw (PSS/E `CONL` with 100 % of P and Q in one class).",
      "oneOf": [
        {
          "enum": [
            "constant_current",
            "constant_power"
          ],
          "type": "string"
        },
        {
          "const": "power_flow",
          "description": "Each load part keeps the voltage law of the static model.",
          "type": "string"
        },
        {
          "const": "constant_impedance",
          "description": "Constant admittance at the power flow voltage (PSS/E `CONL` 100% Z).",
          "type": "string"
        }
      ]
    },
    "LowVoltageLoad": {
      "description": "How the constant-power and constant-current load parts (and exponential\nparts with `γ < 2`) behave at low voltage.",
      "oneOf": [
        {
          "description": "PSS/E `PQBRAK`: below `v_break` (pu, absolute; 0.7 by default as in\nPSS/E) each part draws the constant admittance of its power at the\nbreakpoint, `P(V) = P(V_b) (V / V_b)²`, continuous in value at `V_b`.\nA bus whose power flow voltage `V0` is below `v_break` breaks at `V0`\ninstead, so it starts on its own law.",
          "properties": {
            "kind": {
              "const": "break",
              "type": "string"
            },
            "v_break": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "v_break"
          ],
          "type": "object"
        },
        {
          "description": "The stated law at every voltage down to 20 % of `V0`, below that a\nsmooth floor on the magnitude the parts divide by (as\nPowerSimulationsDynamics.jl applies the law at every voltage; the\nfloor only keeps the current's direction defined at 0 V).",
          "properties": {
            "kind": {
              "const": "exact",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "PoleSlip": {
      "description": "A machine that slipped a pole: the first time its angle relative to its\nisland's COI passed the criterion.",
      "properties": {
        "t": {
          "format": "double",
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "unit",
        "t"
      ],
      "type": "object"
    },
    "Reason": {
      "description": "One reason for the verdict: a stable code and a plain sentence.",
      "properties": {
        "code": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "text"
      ],
      "type": "object"
    },
    "RecordSpec": {
      "description": "What a run records. Without one ([`RmsRequest::record`] `None`) every\nchannel is recorded at every output step.",
      "properties": {
        "channels": {
          "default": [],
          "description": "Channels recorded at every output step: exact keys (`omega:2178`) or\nprefixes ending in `:` (`omega:` for every unit's speed). Empty: every\nchannel.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "checkpoint_step": {
          "default": 0.0,
          "description": "The full state every `checkpoint_step` seconds (0: none), in\n[`RmsResult::checkpoints`]: any channel can be replayed from them\n(`RmsSimulation::replay`). Checkpoints need the `rms-experimental`\nfeature; without it a request for them is noted and none are taken.\nThe field is there under every feature, so the features stay\nadditive.",
          "format": "double",
          "type": "number"
        },
        "frame_step": {
          "default": 0.0,
          "format": "double",
          "type": "number"
        },
        "frames": {
          "default": [],
          "description": "Channels recorded besides every `frame_step` seconds, in\n[`RmsResult::frames`] (the map's bus voltages and angles).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "RmsEvent": {
      "description": "A discrete event at `time` seconds.",
      "oneOf": [
        {
          "description": "Open the branch `(from, to, circuit)`.",
          "properties": {
            "circuit": {
              "default": "1",
              "type": "string"
            },
            "from": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "branch_trip",
              "type": "string"
            },
            "time": {
              "format": "double",
              "type": "number"
            },
            "to": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "time",
            "from",
            "to"
          ],
          "type": "object"
        },
        {
          "description": "Close the branch `(from, to, circuit)` again.",
          "properties": {
            "circuit": {
              "default": "1",
              "type": "string"
            },
            "from": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "branch_close",
              "type": "string"
            },
            "time": {
              "format": "double",
              "type": "number"
            },
            "to": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "time",
            "from",
            "to"
          ],
          "type": "object"
        },
        {
          "description": "A balanced fault to ground through `r + jx` (system per unit).",
          "properties": {
            "bus": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "bus_fault",
              "type": "string"
            },
            "r": {
              "default": 0.0,
              "format": "double",
              "type": "number"
            },
            "time": {
              "format": "double",
              "type": "number"
            },
            "x": {
              "default": 0.0001,
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "time",
            "bus"
          ],
          "type": "object"
        },
        {
          "description": "Remove the fault at `bus`.",
          "properties": {
            "bus": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "clear_fault",
              "type": "string"
            },
            "time": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "time",
            "bus"
          ],
          "type": "object"
        },
        {
          "description": "Scale the load at `bus` (all components) by `scale`.",
          "properties": {
            "bus": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "load_change",
              "type": "string"
            },
            "scale": {
              "format": "double",
              "type": "number"
            },
            "time": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "time",
            "bus",
            "scale"
          ],
          "type": "object"
        },
        {
          "description": "Set a generator's exciter (`v_ref`) or governor (`p_ref`) reference.",
          "properties": {
            "bus": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "set_reference",
              "type": "string"
            },
            "machine_id": {
              "default": "1",
              "type": "string"
            },
            "signal": {
              "$ref": "#/$defs/InputSignal"
            },
            "time": {
              "format": "double",
              "type": "number"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "time",
            "bus",
            "signal",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Disconnect a generator.",
          "properties": {
            "bus": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "generator_trip",
              "type": "string"
            },
            "machine_id": {
              "default": "1",
              "type": "string"
            },
            "time": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "time",
            "bus"
          ],
          "type": "object"
        },
        {
          "description": "A balanced fault inside branch `(from, to, circuit)` at `location`\n(0 at `from`, 1 at `to`) of its series impedance, through `r + jx`.\nA transient fault (`permanent: false`) dies out once both ends are\nopen, so an auto-reclose succeeds.",
          "properties": {
            "circuit": {
              "default": "1",
              "type": "string"
            },
            "from": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "line_fault",
              "type": "string"
            },
            "location": {
              "format": "double",
              "type": "number"
            },
            "permanent": {
              "default": true,
              "type": "boolean"
            },
            "r": {
              "default": 0.0,
              "format": "double",
              "type": "number"
            },
            "time": {
              "format": "double",
              "type": "number"
            },
            "to": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "x": {
              "default": 0.0001,
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "time",
            "from",
            "to",
            "location"
          ],
          "type": "object"
        },
        {
          "description": "Remove the fault inside a branch.",
          "properties": {
            "circuit": {
              "default": "1",
              "type": "string"
            },
            "from": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "clear_line_fault",
              "type": "string"
            },
            "time": {
              "format": "double",
              "type": "number"
            },
            "to": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "time",
            "from",
            "to"
          ],
          "type": "object"
        },
        {
          "description": "Open the breaker of branch `(from, to, circuit)` at bus `at` (one\nend; the other stays connected).",
          "properties": {
            "at": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "circuit": {
              "default": "1",
              "type": "string"
            },
            "from": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "breaker_open",
              "type": "string"
            },
            "time": {
              "format": "double",
              "type": "number"
            },
            "to": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "time",
            "from",
            "to",
            "at"
          ],
          "type": "object"
        },
        {
          "description": "Close that breaker again.",
          "properties": {
            "at": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "circuit": {
              "default": "1",
              "type": "string"
            },
            "from": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "breaker_close",
              "type": "string"
            },
            "time": {
              "format": "double",
              "type": "number"
            },
            "to": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "time",
            "from",
            "to",
            "at"
          ],
          "type": "object"
        }
      ]
