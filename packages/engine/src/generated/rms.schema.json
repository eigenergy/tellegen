    "RmsInspection": {
      "description": "What a case's dynamic data resolves to, for a UI to show before a run.",
      "properties": {
        "base_frequency": {
          "format": "double",
          "type": "number"
        },
        "base_mva": {
          "format": "double",
          "type": "number"
        },
        "branches": {
          "description": "`(from, to, circuit)` of every in-service branch.",
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "buses": {
          "items": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "dyr_records": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "eigenvalues": {
          "items": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": "array"
        },
        "generators": {
          "items": {
            "$ref": "#/$defs/RmsGenerator"
          },
          "type": "array"
        },
        "held_units": {
          "default": [],
