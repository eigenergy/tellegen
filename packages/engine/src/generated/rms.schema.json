            "null"
          ]
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "supported_models": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "buses",
        "base_mva",
        "base_frequency",
        "generators",
        "sources",
        "branches",
        "load_buses",
        "dyr_records",
        "eigenvalues",
        "notes",
        "supported_models"
      ],
      "type": "object"
    },
    "RmsOptions": {
      "description": "Choices of one prepared simulation, fixed when it is built. The defaults\nare tellegen's own; the others exist to compare with another tool or\nmethod, and affect only the simulation they are given to.",
      "properties": {
        "factorize_by_blocks": {
          "default": true,
          "description": "Factorize the step matrices by blocks where every unit allows it, the\ndefault, or always as one sparse LU over all unknowns.",
          "type": "boolean"
        },
        "low_voltage_load": {
          "$ref": "#/$defs/LowVoltageLoad",
          "default": {
            "kind": "break",
            "v_break": 0.7
          },
          "description": "Low-voltage behaviour of the constant-power and constant-current load\nparts: PSS/E's `PQBRAK` conversion at 0.7 pu by default, or the exact\nlaw (PowerSimulationsDynamics.jl)."
        },
        "psid_converter_ramp": {
          "default": false,
          "description": "Apply a renewable plant's converter ramp limits (`REGCA1` `Rrpwr`,\n`Iqrmax`, `Iqrmin`) to the `Tg` lag's error as\nPowerSimulationsDynamics.jl 0.16.2 does (an effective rate\n`Rrpwr/Tg`) instead of to the currents' rate in pu/s (PSS/E).",
          "type": "boolean"
        },
        "psid_lv_gain": {
          "default": false,
          "description": "Use PowerSimulationsDynamics.jl 0.16.2's low-voltage active current\ngain for renewable plants (negative between its two points,\n`get_LV_current_gain`) instead of the PSS/E one.",
          "type": "boolean"
        },
        "psid_saturation": {
          "default": false,
          "description": "Evaluate the quadratic saturation of machines and `ESAC1A` below its\nknee `A` as PowerSimulationsDynamics.jl 0.16.2 does (the formula\n`B (x − A)² / x`, which rises again below `A`) instead of PSS/E's\n`Se = 0` there.",
          "type": "boolean"
        },
        "reactive_limits": {
          "default": true,
          "description": "Initialize from the AC power flow with the generators' reactive\nlimits enforced (PV→PQ switching), the default and the same solve as\nthe static study, or with every generator at its voltage setpoint\nwhatever reactive power that takes (PowerSimulationsDynamics.jl, and\nPSS/E from a case solved without limits). Either way the result's\nnotes name every unit whose solved reactive power and setpoint\ndisagree, and by how much.",
          "type": "boolean"
        },
        "renewable_plants": {
          "default": true,
          "description": "Simulate renewable plants (`REGCA1` + `REECB1` + `REPCA1`), the\ndefault, or hold them at their power flow output as constant currents.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "RmsRequest": {
      "description": "A simulation request.",
      "properties": {
        "dt": {
          "default": 0.0025,
          "description": "Integration step in seconds.",
          "format": "double",
          "type": "number"
        },
        "events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RmsEvent"
          },
          "type": "array"
        },
        "load_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/LoadModel"
            },
            {
              "type": "null"
            }
          ],
          "description": "The load model: for [`simulate`] the one the simulation is built with\n(default [`LoadModel::PowerFlow`]); for [`RmsSimulation::run`] it\nmust be the prepared simulation's or `None`."
        },
        "output_step": {
          "default": 0.005,
          "description": "Output sampling interval in seconds, a multiple of `dt`.",
          "format": "double",
          "type": "number"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "What to record (default: every channel at every output step)."
        },
        "small_signal": {
          "default": false,
          "description": "Compute the eigenvalues of the linearized system at the initial point\n(dense, `O(n³)` in the differential states). Needs the\n`rms-experimental` feature; without it the request is noted and\nskipped.",
          "type": "boolean"
        },
        "t_end": {
          "default": 10.0,
          "description": "End time in seconds.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "RmsScreening": {
      "description": "The screening of a run.",
      "properties": {
        "angle": {
          "$ref": "#/$defs/AngleScreen"
        },
        "criteria": {
          "$ref": "#/$defs/ScreeningCriteria"
        },
        "criteria_name": {
          "description": "The criteria's name, `tellegen-rms-screening-1`.",
          "type": "string"
        },
        "frequency": {
          "$ref": "#/$defs/FrequencyScreen"
        },
        "held_units": {
          "description": "Units held at their power flow output (not simulated).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "islands": {
          "items": {
            "$ref": "#/$defs/IslandScreen"
          },
          "type": "array"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "type": "array"
        },
        "reference_unit": {
          "description": "The unit whose speed turns the reference frame, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/ScreeningVerdict"
        },
        "voltage": {
          "$ref": "#/$defs/VoltageScreen"
        }
      },
      "required": [
        "criteria_name",
        "criteria",
        "verdict",
        "reasons",
        "frequency",
        "angle",
        "voltage",
        "islands",
        "held_units"
      ],
      "type": "object"
    },
    "ScreeningCriteria": {
      "description": "The screening criteria. Every field has a default (`version` 1); a\nrequest may override any of them.",
      "properties": {
        "bus_frequency_filter_s": {
          "default": 0.02,
          "description": "The time constant of the filter on the bus angle derivative of the\nbus frequency estimate, s (the PSS/E `FRQ` convention).",
          "format": "double",
          "type": "number"
        },
        "bus_frequency_min_pu": {
          "default": 0.2,
          "description": "Below this voltage a bus angle is not used for its frequency (the\nestimate holds its last value), pu.",
          "format": "double",
          "type": "number"
        },
        "pole_slip_deg": {
          "default": 180.0,
          "description": "A machine whose rotor angle relative to its island's COI passes\nthis many degrees has slipped a pole.",
          "format": "double",
          "type": "number"
        },
        "rocof_window_s": {
          "default": 0.5,
          "description": "The sliding window of the rate of change of the COI frequency, s.",
          "format": "double",
          "type": "number"
        },
        "runaway_pu": {
          "default": 0.05,
          "description": "An island whose COI speed ends further than this from 1 pu runs\naway, pu.",
          "format": "double",
          "type": "number"
        },
        "settle_angle_deg": {
          "default": 1.0,
          "description": "Settled: the largest rotor angle separation stays within this of its\nfinal value over the window, degrees.",
          "format": "double",
          "type": "number"
        },
        "settle_frequency_hz": {
          "default": 0.01,
          "description": "Settled: the COI frequency stays within this of its final value over\nthe window, Hz.",
          "format": "double",
          "type": "number"
        },
        "settle_window_s": {
          "default": 2.0,
          "description": "The span at the end of the run over which the run must have settled, s.",
          "format": "double",
          "type": "number"
        },
        "version": {
          "default": 1,
          "description": "The version of the defaults, `1`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "voltage_recovery_pu": {
          "default": 0.8,
          "description": "Every live bus must be at or above this voltage, pu ...",
          "format": "double",
          "type": "number"
        },
        "voltage_recovery_s": {
          "default": 1.0,
          "description": "... within this long after the last event, s.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "ScreeningVerdict": {
      "description": "The outcome of a screening.",
      "oneOf": [
        {
          "const": "stable",
          "description": "No pole slip, no runaway island, settled by the end of the run.",
          "type": "string"
        },
        {
          "const": "loss_of_synchronism",
          "description": "A machine slipped a pole.",
          "type": "string"
        },
        {
          "const": "island_runaway",
          "description": "An island's COI speed ran away.",
          "type": "string"
        },
        {
          "const": "not_settled",
          "description": "Not settled by the end of the run: extend it.",
          "type": "string"
        }
      ]
    },
    "SwingTrend": {
      "description": "The trend of the rotor angle separation after the last event, read from\nthe peaks of its distance to its final value. Only peaks above\n[`TREND_FLOOR_DEG`] and above [`TREND_FLOOR_FRACTION`] of the largest\ndistance count: smaller wiggles are numerical, not swings.",
      "oneOf": [
        {
          "const": "decaying",
          "description": "The last three counted peaks each shrink by more than 2 %.",
          "type": "string"
        },
        {
          "const": "growing",
          "description": "The last three counted peaks each grow by more than 2 %.",
          "type": "string"
        },
        {
          "const": "damped_out",
          "description": "The swings fell below the floor, and within the settling criterion's\nangle band, before the end of the run (or never rose above them).",
          "type": "string"
        },
        {
          "const": "sustained",
          "description": "Three or more counted peaks, the last one still counted, with no\nmonotone trend in the last three: the swings neither grow nor decay.",
          "type": "string"
        },
        {
          "const": "undetermined",
          "description": "Too few counted peaks to tell (such as one large swing cut off by\nthe end of the run), or a last peak below the floor but outside the\nsettling band.",
          "type": "string"
        }
      ]
    },
    "VoltageScreen": {
      "description": "Bus voltage figures, pu.",
      "properties": {
        "final_max_pu": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "final_min_pu": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "last_event_t": {
          "description": "The time of the last event, s (0 without events).",
          "format": "double",
          "type": "number"
        },
        "min_bus": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "min_pu": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "min_t": {
          "format": "double",
          "type": "number"
        },
        "recovered": {
          "type": "boolean"
        },
        "recovered_s": {
          "description": "How long after the last event every live bus is back at or above\nthe criterion for good, s; `None`: not by the end of the run.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "min_t",
        "last_event_t",
        "recovered"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "criteria": {
      "$ref": "#/$defs/ScreeningCriteria"
    },
    "event": {
      "$ref": "#/$defs/RmsEvent"
    },
    "generator": {
      "$ref": "#/$defs/RmsGenerator"
    },
    "inspection": {
      "$ref": "#/$defs/RmsInspection"
    },
    "options": {
      "$ref": "#/$defs/RmsOptions"
    },
    "request": {
      "$ref": "#/$defs/RmsRequest"
    },
    "screening": {
      "$ref": "#/$defs/RmsScreening"
    }
  },
  "required": [
    "request",
    "options",
    "inspection",
    "criteria",
    "screening",
    "generator",
    "event"
  ],
  "title": "RmsSchema",
  "type": "object",
