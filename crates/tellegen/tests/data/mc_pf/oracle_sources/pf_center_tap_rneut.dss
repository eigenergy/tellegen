! Centre-tap transformer whose only secondary earth path is the winding-2
! rneut/xneut branch. Unequal leg loads force current through that finite path.

Clear
Set DefaultBaseFreq=50

New Circuit.pf_ct_rneut basekv=7.2 pu=1.0 angle=0 phases=1 bus1=hv.1.0 model=ideal

New Transformer.t1 phases=1 windings=3
~ wdg=1 bus=hv.1.4 conn=wye kv=7.2 kva=25 %r=0.6
~ wdg=2 bus=lv.1.4 conn=wye kv=0.120 kva=25 %r=1.2 rneut=2 xneut=1
~ wdg=3 bus=lv.4.2 conn=wye kv=0.120 kva=25 %r=1.2 rneut=-1
~ XHL=2.04 XLT=1.36 XHT=2.04
~ %noloadloss=0
~ %imag=0

New Load.ld1 bus1=lv.1.4 kv=0.120 kw=9 kvar=3 phases=1 model=1 Vminpu=0 Vmaxpu=2
New Load.ld2 bus1=lv.4.2 kv=0.120 kw=3 kvar=1 phases=1 model=1 Vminpu=0 Vmaxpu=2

Set VoltageBases=[7.2, 0.120]
CalcVoltageBases
Set Tolerance=1e-8
Set MaxIterations=100
Solve
